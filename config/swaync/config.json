{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-window-width": 430,
  "control-center-width": 440,
  "control-center-height": 720,
  "fit-to-screen": true,
  "layer-shell": true,
  "cssPriority": "user",
  "notification-icon-size": 56,
  "image-visibility": "when-available",
  "image-size": 96,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "widgets": ["mpris", "title", "dnd", "notifications"],
  "widget-config": {
    "title": {
      "text": "通知",
      "clear-all-button": true,
      "button-text": "全部清除"
    },
    "dnd": {"text": "勿扰模式"},
    "mpris": {"image-size": 84, "image-radius": 12},
    "notifications": {}
  }
}
