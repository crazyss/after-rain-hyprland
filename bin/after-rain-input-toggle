#!/usr/bin/env bash
set -euo pipefail

english_engine="xkb:us::eng"
chinese_engine="libpinyin"
ibus_daemon=${AFTER_RAIN_IBUS_DAEMON:-/usr/bin/ibus-daemon}
current=$(ibus engine 2>/dev/null || true)

# Ctrl+Space is also the recovery path for a missed session autostart.  This
# keeps the shortcut useful instead of only reporting that IBus is offline.
if [[ -z "$current" ]]; then
  "$ibus_daemon" -drx >/dev/null 2>&1 || true
  for _ in {1..20}; do
    current=$(ibus engine 2>/dev/null || true)
    [[ -n "$current" ]] && break
    sleep 0.05
  done
fi

if [[ "$current" == "$chinese_engine" ]]; then
  target=$english_engine
  label="English"
else
  target=$chinese_engine
  label="中文 · LibPinyin"
fi

ibus engine "$target" >/dev/null 2>&1 || true
switched=0
for _ in {1..20}; do
  if [[ $(ibus engine 2>/dev/null || true) == "$target" ]]; then
    switched=1
    break
  fi
  sleep 0.05
done
if (( switched == 0 )); then
  notify-send -a "After Rain" "输入法切换失败" "请检查 ibus-daemon 与 $target" >/dev/null 2>&1 || true
  exit 1
fi
notify-send -a "After Rain" "输入法" "$label" >/dev/null 2>&1 || true
printf '%s\n' "$target"
