#!/usr/bin/env python3
"""Keep Hyprland workspaces 1-4 paired with their character wallpaper."""

from __future__ import annotations

import os
from pathlib import Path
import socket
import subprocess
import sys
import time

BIN_ROOT = Path(__file__).resolve().parent


def wallpaper(workspace_id: str) -> None:
    if workspace_id not in {"1", "2", "3", "4"}:
        return
    subprocess.run(
        [str(BIN_ROOT / "after-rain-wallpaper"), "workspace", workspace_id, "--quiet"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def active_workspace() -> str | None:
    result = subprocess.run(
        ["hyprctl", "activeworkspace", "-j"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    import json

    try:
        return str(json.loads(result.stdout)["id"])
    except (KeyError, TypeError, ValueError):
        return None


def event_socket() -> Path:
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not signature or not runtime:
        raise RuntimeError("Hyprland session environment is unavailable")
    candidates = (
        Path(runtime) / "hypr" / signature / ".socket2.sock",
        Path("/tmp/hypr") / signature / ".socket2.sock",
    )
    for candidate in candidates:
        if candidate.exists():
            return candidate
    raise RuntimeError(f"Hyprland event socket not found below {runtime}/hypr/{signature}")


def watch() -> int:
    current = active_workspace()
    if current:
        wallpaper(current)

    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                connection.connect(str(event_socket()))
                buffer = b""
                while chunk := connection.recv(4096):
                    buffer += chunk
                    while b"\n" in buffer:
                        raw, buffer = buffer.split(b"\n", 1)
                        event = raw.decode("utf-8", errors="replace")
                        if event.startswith("workspacev2>>"):
                            wallpaper(event.removeprefix("workspacev2>>").split(",", 1)[0])
                        elif event.startswith("workspace>>"):
                            workspace_id = active_workspace()
                            if workspace_id:
                                wallpaper(workspace_id)
        except (ConnectionError, FileNotFoundError, RuntimeError, OSError):
            time.sleep(1)


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "watch":
        return watch()
    if len(sys.argv) == 2 and sys.argv[1] == "sync":
        workspace_id = active_workspace()
        if workspace_id:
            wallpaper(workspace_id)
            return 0
        return 1
    if len(sys.argv) == 2 and sys.argv[1] in {str(number) for number in range(1, 11)}:
        # Hyprland 0.56's Lua config provider expects a Lua dispatcher
        # expression.  The legacy `dispatch workspace N` form is rewritten as
        # invalid Lua (`hl.dispatch(workspace N)`) and silently breaks the
        # Super+number callbacks.
        subprocess.run(
            [
                "hyprctl",
                "dispatch",
                f"hl.dsp.focus({{ workspace = {sys.argv[1]} }})",
            ],
            check=True,
        )
        wallpaper(sys.argv[1])
        return 0
    print("Usage: after-rain-workspace {1..10|sync|watch}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
