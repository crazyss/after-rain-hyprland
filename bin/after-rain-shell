#!/usr/bin/env bash
set -euo pipefail

config_name=after-rain
bin_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
local_lib="${HOME}/.local/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || printf 'x86_64-linux-gnu')"
export LD_LIBRARY_PATH="$local_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

find_qs() {
  if command -v qs >/dev/null 2>&1; then
    command -v qs
  elif command -v quickshell >/dev/null 2>&1; then
    command -v quickshell
  elif [[ -x "$HOME/.local/bin/qs" ]]; then
    printf '%s\n' "$HOME/.local/bin/qs"
  elif [[ -x "$HOME/.local/bin/quickshell" ]]; then
    printf '%s\n' "$HOME/.local/bin/quickshell"
  else
    return 1
  fi
}

ipc() {
  qs_bin=$(find_qs) || return 1
  timeout 2 "$qs_bin" -c "$config_name" ipc call shell "$@"
}

case "${1:-}" in
  rain)
    if [[ "${2:-}" == --help || "${2:-}" == -h ]]; then
      echo 'Usage: after-rain-shell rain {status|toggle|off|light|normal|heavy}'
      echo 'Returns JSON. Exit codes: 0 success, 1 runtime/persistence error, 2 usage error.'
      echo 'Examples: after-rain-shell rain normal; after-rain-shell rain status | jq .'
      exit 0
    fi
    if [[ $# != 2 ]]; then
      echo '{"ok":false,"error":{"code":"USAGE","message":"Use: after-rain-shell rain status|toggle|off|light|normal|heavy"}}' >&2
      exit 2
    fi
    case "$2" in
      status|toggle) rain_args=("$2") ;;
      off|light|normal|heavy) rain_args=(setMode "$2") ;;
      *) echo '{"ok":false,"error":{"code":"INVALID_MODE","message":"Use off, light, normal or heavy; see rain --help"}}' >&2; exit 2 ;;
    esac
    qs_bin=$(find_qs) || {
      echo '{"ok":false,"error":{"code":"QS_MISSING","message":"Install Quickshell; see docs/QUICKSHELL.zh-CN.md"}}' >&2
      exit 1
    }
    if ! rain_result=$(timeout 3 "$qs_bin" -c "$config_name" ipc call rain "${rain_args[@]}"); then
      echo '{"ok":false,"error":{"code":"IPC_FAILED","message":"Check after-rain-shell status and rain status before retrying a mutation"}}' >&2
      exit 1
    fi
    if [[ "$rain_result" == *'"ok":false'* ]]; then
      printf '%s\n' "$rain_result" >&2
      exit 1
    fi
    printf '%s\n' "$rain_result"
    ;;
  run)
    qs_bin=$(find_qs) || {
      echo "Quickshell 0.3.1 is not installed." >&2
      exit 127
    }
    exec "$qs_bin" -c "$config_name"
    ;;
  ping)
    [[ "$(ipc ping 2>/dev/null || true)" == ok ]]
    ;;
  wait-ready)
    for _attempt in {1..40}; do
      "$0" ping && exit 0
      sleep 0.25
    done
    echo "After Rain Shell IPC did not become ready." >&2
    exit 1
    ;;
  toggle-keybindings)
    if "$0" ping && ipc toggleKeybindings >/dev/null 2>&1; then
      exit 0
    fi
    exec "$bin_root/after-rain-keybinds"
    ;;
  show-keybindings)
    if "$0" ping && ipc showKeybindings >/dev/null 2>&1; then
      exit 0
    fi
    exec "$bin_root/after-rain-keybinds"
    ;;
  hide-keybindings)
    "$0" ping && ipc hideKeybindings >/dev/null
    ;;
  reload-bindings)
    "$0" ping && ipc reloadBindings >/dev/null
    ;;
  restart)
    systemctl --user restart after-rain-shell.service
    ;;
  status)
    qs_bin=$(find_qs 2>/dev/null || true)
    printf 'binary=%s\n' "${qs_bin:-missing}"
    if "$0" ping; then
      echo 'health=ok'
    else
      echo 'health=down'
      exit 1
    fi
    ;;
  *)
    echo "Usage: after-rain-shell {run|ping|wait-ready|toggle-keybindings|show-keybindings|hide-keybindings|reload-bindings|restart|status|rain}" >&2
    exit 2
    ;;
esac
